# Shared runtime configuration for SHELLFORGE (backend + laboratoires)

# Base de données SQLite
SHELLFORGE_DB_DIR=./database
SHELLFORGE_DB_PATH=./database/shellforge.db

# Espace de travail des laboratoires (un dossier par session puis par mission)
# Par défaut : $TMPDIR/shellforge-labs
# SHELLFORGE_LAB_ROOT=/tmp/shellforge-labs

# Durée maximale d'une commande dans le laboratoire (secondes)
SHELLFORGE_LAB_TIMEOUT=20

# CORS : origines explicites (développement local)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# CORS : origines par expression régulière (hôtes de prévisualisation)
# Par défaut : localhost tous ports + *.e2b.app
# CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?|https?://[a-z0-9-]+\.e2b\.app
